# Copy this file to .env for local use. Do not commit .env files.

# ===== WEATHER API CONFIGURATION =====
# Get your free API key from: https://www.weatherapi.com/
WEATHER_API_KEY=your_api_key_here

# ===== DATABASE CONFIGURATION =====
# SQLite configuration
SQLITE_DB_PATH=weather_app.db

# ===== FLASK CONFIGURATION =====
FLASK_ENV=development
FLASK_DEBUG=True

# ===== CORS CONFIGURATION =====
# Frontend origin for CORS headers
FRONTEND_URL=http://localhost:5173
# Optional: backend constant currently reads CORS_ORIGINS
# CORS_ORIGINS=http://localhost:5173
